rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/k-voting/public/data/evidences/{evidenceId} {
      function isValidCategory(category) {
        return category in [
          'shape-memory',
          'strange-ballot',
          'bad-management',
          'nec-admin',
          'etc',
          'free-board',
          'feedback-board'
        ];
      }

      function hasOnlyEvidenceFields(data) {
        return data.keys().hasOnly([
          'id',
          'title',
          'category',
          'images',
          'mediaLinks',
          'source',
          'desc',
          'likes',
          'comments',
          'passwordHash',
          'createdAt',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]);
      }

      function hasValidCoreFields(data) {
        return data.id == evidenceId
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 120
          && data.category is string
          && isValidCategory(data.category);
      }

      function hasValidOptionalFields(data) {
        return (!data.keys().hasAny(['source']) || (data.source is string && data.source.size() <= 160))
          && (!data.keys().hasAny(['desc']) || (data.desc is string && data.desc.size() <= 5000))
          && (!data.keys().hasAny(['images']) || (data.images is list && data.images.size() <= 6))
          && (!data.keys().hasAny(['mediaLinks']) || (data.mediaLinks is list && data.mediaLinks.size() <= 10))
          && (!data.keys().hasAny(['comments']) || (data.comments is list && data.comments.size() <= 100))
          && (!data.keys().hasAny(['likes']) || (data.likes is int && data.likes >= 0 && data.likes <= 100000))
          && (!data.keys().hasAny(['createdAt']) || data.createdAt is string)
          && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string)
          && (!data.keys().hasAny(['deleted']) || data.deleted is bool)
          && (!data.keys().hasAny(['deletedAt']) || data.deletedAt is string);
      }

      function hasValidPasswordHash(data) {
        return data.passwordHash is string
          && data.passwordHash.size() == 64;
      }

      function hasValidLegacyOrCurrentPasswordHash(data) {
        return !data.keys().hasAny(['passwordHash'])
          || (data.passwordHash is string
            && (data.passwordHash.size() == 0 || data.passwordHash.size() == 64));
      }

      function hasValidCreateState(data) {
        return data.likes == 0
          && data.comments is list
          && data.comments.size() == 0
          && data.createdAt is string
          && !data.keys().hasAny(['deleted', 'deletedAt']);
      }

      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function currentCommentCount() {
        return resource.data.keys().hasAny(['comments']) && resource.data.comments is list
          ? resource.data.comments.size()
          : 0;
      }

      function validPublicComment(comment) {
        return comment is map
          && comment.keys().hasOnly(['author', 'text', 'passwordHash', 'isAdmin'])
          && comment.author is string
          && comment.author.size() > 0
          && comment.author.size() <= 40
          && comment.text is string
          && comment.text.size() > 0
          && comment.text.size() <= 1000
          && comment.passwordHash is string
          && comment.passwordHash.size() == 64
          && comment.isAdmin == false;
      }

      function isLikeIncrement() {
        return changedOnly(['likes', 'updatedAt'])
          && resource.data.likes is int
          && request.resource.data.likes == resource.data.likes + 1
          && request.resource.data.likes <= 100000
          && request.resource.data.updatedAt is string;
      }

      function isPublicCommentAppend() {
        return changedOnly(['comments', 'updatedAt'])
          && request.resource.data.comments is list
          && request.resource.data.comments.size() == currentCommentCount() + 1
          && request.resource.data.comments.size() <= 100
          && validPublicComment(request.resource.data.comments[currentCommentCount()])
          && request.resource.data.updatedAt is string;
      }

      allow read: if true;
      allow create: if hasOnlyEvidenceFields(request.resource.data)
        && hasValidCoreFields(request.resource.data)
        && hasValidOptionalFields(request.resource.data)
        && hasValidPasswordHash(request.resource.data)
        && hasValidCreateState(request.resource.data);
      allow update: if hasOnlyEvidenceFields(request.resource.data)
        && hasValidCoreFields(request.resource.data)
        && hasValidOptionalFields(request.resource.data)
        && request.resource.data.id == resource.data.id
        && (!resource.data.keys().hasAny(['passwordHash']) || request.resource.data.passwordHash == resource.data.passwordHash)
        && (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt)
        && hasValidLegacyOrCurrentPasswordHash(request.resource.data)
        && (isLikeIncrement() || isPublicCommentAppend());
      allow delete: if false;
    }

    match /artifacts/k-voting/public/data/stats/categoryCounts {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
