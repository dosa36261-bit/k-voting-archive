rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All mutations pass through archiveApi. Private collections are denied.
    match /artifacts/k-voting/public/data/evidences/{evidenceId} {
      allow read: if true;
      allow write: if false;
    }
    match /artifacts/k-voting/public/data/stats/categoryCounts {
      allow read: if true;
      allow write: if false;
    }
  }
}
