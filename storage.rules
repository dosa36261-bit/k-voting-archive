rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /evidence-images/{evidenceId}/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
  }
}
